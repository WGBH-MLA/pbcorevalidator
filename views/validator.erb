<% if @validator && @validator.valid? %>
  <div class="box-gray">
    <p>
      <span class="success">
        Congratulations! I couldn't find any errors in the PBCore document you provided. Hooray!
      </span>
    </p>
  </div>
<% elsif @errors %>
  <div class="box-gray">
    <p style="font-size: 28px;">
      <span class="failure">
        Sorry. The following potential errors were found in your PBCore document:

        <% if @errors[:xml] && @errors[:xml].first %>
          <div class="box-gray">
            <h2>PBCore Schema Errors</h2>
            <ul>
              <% @errors[:xml].each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>


        <% if @errors[:best_practices] && @errors[:best_practices].first %>
          <div class="box-gray">
            <h2>Best Practices</h2>
            <ul>
              <% @errors[:best_practices].each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>



        <% if @errors[:vocabs] && @errors[:vocabs].first %>
          <div class="box-gray">
            <h2>Controlled Vocabularies</h2>
            <ul>
              <% @errors[:vocabs].each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>


        <% if @errors[:fail] && @errors[:fail].first %>
          <div class="box-gray">
            <h2>Input Failure</h2>
            <ul>
              <% @errors[:fail].each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>


        <% if @validator && !validator.valid_xml? %>
          <div class="box-gray">
            <p>
              Note that these errors indicate that your input could not even be parsed as XML. Please fix those errors in order to allow the PBCore-specific checks to be run.
            </p>
          </div>
        <% end %>


      </span>
    </p>
  </div>


<% end %>

<a href="/" class="button">Go Back</a>
